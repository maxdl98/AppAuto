<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manutenzione Facile</title>
    <style>
        /* Stile generale */
        body {
            font-family: Arial, sans-serif;
            background-color: #000;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
            color: #fff;
        }

        /* Top bar */
        .topbar {
            width: 100%;
            background-color: #e07fe0;
            padding: 15px 20px;
            display: flex;
            justify-content: flex-end; /* Aggiustato per far stare a destra il logout */
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 10;
        }

        .topbar .logout-btn {
            background-color: #e07fe0;
            color: white;
            padding: 12px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.3s;
            position: relative;
    right: 20px;
        }

        .topbar .logout-btn:hover {
            background-color: #c97bcd;
        }

        /* Contenitore principale */
        .container {
            background-color: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 600px; /* Modificato per essere più largo */
            text-align: center;
            margin-top: 80px;
        }

        .container h2 {
            margin-bottom: 20px;
            font-size: 2rem;
            color: #e07fe0;
        }

        .container p {
            color: #555;
            font-size: 1rem;
            margin-bottom: 30px;
        }

        /* Form di inserimento auto */
        .auto-form {
            text-align: left;
            margin-top: 20px;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 10px;
        }

        .auto-form label {
            font-weight: bold;
            color: #e07fe0;
            display: block;
            margin: 10px 0 5px;
        }

        .auto-form input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 10px;
            font-size: 1rem;
        }

        .auto-form button {
            width: 100%;
            padding: 10px;
            background-color: #e07fe0;
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
        }

        .auto-form button:hover {
            background-color: #c97bcd;
        }
    </style>
</head>

<body>
    <!-- Top bar -->
    <div class="topbar">
        <button id="logoutBtn" class="logout-btn">Logout</button>
        <img src="/chiave.jpg" alt="chiave" class="foto" />
    </div>

    <!-- Form per raccogliere i dati dell'auto -->
    <div class="container">
        <h2>Inserisci i Dati della tua Auto</h2>

        <div class="auto-form">
            <label for="model">Modello dell'auto</label>
            <input type="text" id="model" placeholder="Inserisci il modello dell'auto">

            <label for="mileage">Quanti chilometri hai fatto dall'ultima manutenzione?</label>
            <input type="number" id="mileage" placeholder="Inserisci il chilometraggio">

            <label for="maintenanceDate">Data dell'ultima manutenzione</label>
            <input type="date" id="maintenanceDate">

            <label for="batteryDuration">Quanto tempo fa hai cambiato la batteria? (in anni)</label>
            <input type="number" id="batteryDuration" placeholder="Inserisci gli anni">

            <button id="saveCarBtn">Salva Auto</button>
        </div>
    </div>

    <script>
        // Funzione per salvare i dati dell'auto
        document.getElementById('saveCarBtn').addEventListener('click', function () {
            const model = document.getElementById('model').value;
            const mileage = document.getElementById('mileage').value;
            const maintenanceDate = document.getElementById('maintenanceDate').value;
            const batteryDuration = document.getElementById('batteryDuration').value;

            if (!model || !mileage || !maintenanceDate || !batteryDuration) {
                alert("Per favore, compila tutti i campi.");
                return;
            }

            const userId = localStorage.getItem("userId");

            if (!userId) {
                alert("Devi essere loggato per salvare l'auto.");
                return;
            }

            fetch('http://localhost:8080/api/v1/automob', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    km_totali: mileage,
                    modello: model,
                    duratabatt: batteryDuration,
                    data: maintenanceDate,
                    utente: { id: userId }
                })
            })
                .then(response => response.json())
                .then(data => {
                    alert("Auto salvata con successo!");
                    const carId = data.id_auto;

                    return fetch('http://localhost:8080/api/v1/idauto/cambiobatt', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            id_auto: carId,
                            modello: model,
                            km_totali: mileage,
                            duratabatt: batteryDuration,
                            data: maintenanceDate,
                            utente: { id: userId }
                        })
                    });
                })
                .then(response => {
                    if (!response.ok) {
                        console.warn("Errore silenzioso durante l'associazione della manutenzione.");
                        console.error('Errore di rete:', response.statusText);
                    } else {
                        console.log("Manutenzione associata con successo.");
                    }
                })
                .catch(error => {
                    console.error("Errore non gestito:", error);
                });
        });

        // Logout
        document.getElementById('logoutBtn').addEventListener('click', () => {
            localStorage.removeItem("userId");
            window.location.href = 'Login.html';
        });

        // Carica l'email utente
        window.onload = function () {
            const userEmail = localStorage.getItem("userEmail");
            document.getElementById('userEmail').innerText = userEmail || "Email non trovata.";
        };
    </script>
</body>

</html>
