package com.jaita120.service;

import java.util.HashSet;
import java.util.Optional;
import java.util.Set;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.jaita120.entities.Auto;
import com.jaita120.entities.Tipo_Manutenzione;
import com.jaita120.entities.Utente;
import com.jaita120.repository.AutoRepository;
import com.jaita120.repository.TipoManutenzioneRepository;
import com.jaita120.repository.UtentiRepository;

import jakarta.transaction.Transactional;

@Service
public class AutoServiceImpl implements AutoService {
	
	
	@Autowired
	private AutoRepository Arepository;
	
	@Autowired
	private UtentiRepository Urepository;
	
	@Autowired
	private TipoManutenzioneRepository Trepository;
	
	

	@Override
	public Auto save(Auto auto) throws Exception {
	    // 1. Recupera l'utente associato all'auto dal corpo della richiesta
	    Utente utente = auto.getUtente();
	    
	    if (utente == null || utente.getId() == null) {
	        throw new IllegalArgumentException("L'utente non è valido o manca l'ID.");
	    }

	    // 2. Verifica che l'utente esista nel database
	    Utente utenteOnDb = Urepository.findById(utente.getId());

	    if (utenteOnDb == null) {
	        throw new IllegalArgumentException("L'utente con ID " + utente.getId() + " non esiste nel database.");
	    }

	    // 3. Associa l'utente all'auto
	    auto.setUtente(utenteOnDb);

	    // 4. Salva l'auto nel database
	    Auto savedAuto = Arepository.save(auto);

	    // 5. Restituisci l'auto salvata
	    return savedAuto;
	}



	@Override
	public Optional<Auto> findById(Integer id_auto) {
		return Arepository.findById(id_auto);
		
		
	}



	

	@Transactional  // La transazione è attiva per tutti i metodi in questa classe
	@Override
	public void manutenzioni(Integer idAuto, Integer kmTotali, Integer durataBatteria) throws Exception {
	    // Recupera l'auto dal database usando id_auto
	    Auto auto = Arepository.findById(idAuto).orElseThrow(() -> new Exception("Auto non trovata"));

	    // Applica la logica di manutenzione in base ai parametri ricevuti
	    if (durataBatteria > 5 && kmTotali < 10000) {
	        Tipo_Manutenzione tipoManutenzione = Trepository.findById(2).orElseThrow(() -> new Exception("Tipo di manutenzione non trovato"));
	        
	        // Aggiungi la manutenzione solo se non è già associata
	        if (!auto.getManutenzioni().contains(tipoManutenzione)) {
	            auto.getManutenzioni().add(tipoManutenzione);
	        }
	    }

	    if (kmTotali >= 10000 && kmTotali <= 20000 && durataBatteria > 5) {
	        Tipo_Manutenzione tipoManutenzione1 = Trepository.findById(52).orElseThrow(() -> new Exception("Tipo di manutenzione non trovato"));
	        
	        // Aggiungi la manutenzione solo se non è già associata
	        if (!auto.getManutenzioni().contains(tipoManutenzione1)) {
	            auto.getManutenzioni().add(tipoManutenzione1);
	        }
	    }

	    if (kmTotali >= 10000 && kmTotali <= 20000 && durataBatteria < 5) {
	        Tipo_Manutenzione tipoManutenzione3 = Trepository.findById(1).orElseThrow(() -> new Exception("Tipo di manutenzione non trovato"));

	        // Aggiungi la manutenzione solo se non è già associata
	        if (!auto.getManutenzioni().contains(tipoManutenzione3)) {
	            auto.getManutenzioni().add(tipoManutenzione3);
	        }
	    }

	    if (kmTotali >= 100000) {
	        Tipo_Manutenzione tipoManutenzione4 = Trepository.findById(152).orElseThrow(() -> new Exception("Tipo di manutenzione non trovato"));

	        // Aggiungi la manutenzione solo se non è già associata
	        if (!auto.getManutenzioni().contains(tipoManutenzione4)) {
	            auto.getManutenzioni().add(tipoManutenzione4);
	        }
	    }

	    // Salva l'auto aggiornata con le nuove manutenzioni
	    Arepository.save(auto);
	}

	
	





	
		
		
		
	}




		
	
	

	
	
	

	

