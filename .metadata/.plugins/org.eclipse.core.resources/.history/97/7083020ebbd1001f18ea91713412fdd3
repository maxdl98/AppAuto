<body>
    <!-- Top bar -->
    <div class="topbar">
        <div>
            <img src="https://cdn.pixabay.com/photo/2013/04/01/08/26/tools-98391_1280.png" alt="chiave" class="foto" />
        </div>
        <div class="user-email" id="userEmail">Email Utente</div>
        <button id="logoutBtn" class="logout-btn">Logout</button>
    </div>

    <!-- Contenitore principale -->
    <div class="container">
        <h2>Inserisci i Dati della tua Auto</h2>

        <div class="auto-form">
            <label for="model">Modello dell'auto</label>
            <input type="text" id="model" placeholder="Inserisci il modello dell'auto">

            <label for="mileage">Quanti chilometri hai fatto dall'ultima manutenzione?</label>
            <input type="number" id="mileage" placeholder="Inserisci il chilometraggio">

            <label for="maintenanceDate">Data dell'ultima manutenzione</label>
            <input type="date" id="maintenanceDate">

            <label for="batteryDuration">Quanto tempo fa hai cambiato la batteria? (in anni)</label>
            <input type="number" id="batteryDuration" placeholder="Inserisci gli anni">

            <!-- Pulsante per salvare l'auto -->
            <button id="saveCarBtn">Salva Auto</button>

            <!-- Pulsante per scoprire la manutenzione -->
            <button id="discoverMaintenanceBtn" style="margin-top: 10px;">Scopri la Manutenzione</button>
        </div>
    </div>

    <script>
        let carId = null; // Variabile per memorizzare l'ID dell'auto generato

        // Mostra l'email salvata nella topbar
        window.onload = function () {
            const userEmail = localStorage.getItem("usurname"); // Recupera l'email dal localStorage
            const emailDisplay = document.getElementById("userEmail");

            if (userEmail) {
                emailDisplay.textContent = `Benvenuto, ${userEmail}`;
            } else {
                emailDisplay.textContent = "Email non trovata.";
            }
        };

        // Funzione per salvare i dati dell'auto tramite POST
        document.getElementById('saveCarBtn').addEventListener('click', function () {
            const model = document.getElementById('model').value;
            const mileage = document.getElementById('mileage').value;
            const maintenanceDate = document.getElementById('maintenanceDate').value;
            const batteryDuration = document.getElementById('batteryDuration').value;

            if (!model || !mileage || !maintenanceDate || !batteryDuration) {
                alert("Per favore, compila tutti i campi.");
                return;
            }

            const userId = localStorage.getItem("userId");

            if (!userId) {
                alert("Devi essere loggato per salvare l'auto.");
                return;
            }

            // Dati da inviare al server
            const autoData = {
                km_totali: mileage,
                modello: model,
                duratabatt: batteryDuration,
                data: maintenanceDate,
                utente: { id: userId }
            };

            // Esegue il POST per salvare i dati
            fetch('http://localhost:8080/api/v1/automob', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(autoData)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Errore HTTP! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    carId = data.id_auto; // Memorizza l'ID dell'auto per il PUT
                    alert("Auto salvata con successo!");
                })
                .catch(error => {
                    console.error("Errore non gestito:", error);
                    alert("Si è verificato un errore durante il salvataggio.");
                });
        });

        // Funzione per aggiornare i dati dell'auto tramite PUT
        document.getElementById('discoverMaintenanceBtn').addEventListener('click', function () {
            const model = document.getElementById('model').value;
            const mileage = document.getElementById('mileage').value;
            const maintenanceDate = document.getElementById('maintenanceDate').value;
            const batteryDuration = document.getElementById('batteryDuration').value;

            if (!model || !mileage || !maintenanceDate || !batteryDuration) {
                alert("Per favore, compila tutti i campi.");
                return;
            }

            const userId = localStorage.getItem("userId");

            if (!userId) {
                alert("Devi essere loggato per aggiornare l'auto.");
                return;
            }

            if (!carId) {
                alert("Devi prima salvare l'auto prima di scoprire la manutenzione.");
                return;
            }

            // Dati da inviare al server per l'aggiornamento
            const autoData = {
                id_auto: carId,
                km_totali: mileage,
                modello: model,
                duratabatt: batteryDuration,
                data: maintenanceDate,
                utente: { id: userId }
            };

            // Esegue il PUT per aggiornare i dati
            fetch('http://localhost:8080/api/v1/idauto/cambiobatt', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(autoData)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Errore HTTP! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    alert("Manutenzione aggiornata con successo!");
                })
                .catch(error => {
                    console.error("Errore non gestito:", error);
                    alert("Si è verificato un errore durante l'aggiornamento.");
                });
        });

        // Logout
        document.getElementById("logoutBtn").addEventListener("click", () => {
            localStorage.removeItem("userId");
            localStorage.removeItem("usurname");
            window.location.href = 'Login.html';
        });
    </script>
</body>
