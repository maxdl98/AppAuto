ì<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manutenzione Facile</title>
    <style>
        /* Stile generale */
        body {
            font-family: Arial, sans-serif;
            background-color: #000;  /* Sfondo nero */
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
            color: #fff;  /* Testo bianco per contrasto */
        }

        /* Top bar */
        .topbar {
            width: 100%;
            background-color: #e07fe0;  /* Colore della topbar */
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 10;
        }

        /* Email al centro */
        .topbar .email {
            color: white;
            font-size: 1rem;
            text-align: center;
            flex-grow: 1;
        }

        /* Pulsante di logout a sinistra */
        .topbar .logout-btn {
            background-color: #e07fe0;  /* Colore del pulsante logout */
            color: white;
            padding: 12px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-right: 20px;  /* Spostato a sinistra */
        }

        .topbar .logout-btn:hover {
            background-color: #c97bcd;  /* Colore al passaggio del mouse */
        }

        /* Contenitore principale */
        .container {
            background-color: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 500px;
            text-align: center;
            margin-top: 80px; /* Distanza dalla top bar */
        }

        /* Titolo */
        .container h2 {
            margin-bottom: 20px;
            font-size: 2rem;
            color: #e07fe0;  /* Colore per il titolo */
        }

        /* Messaggio introduttivo */
        .container p {
            color: #555;
            font-size: 1rem;
            margin-bottom: 30px;
        }

        /* Form di inserimento auto */
        .auto-form {
            text-align: left;
            margin-top: 20px;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 10px;
        }

        .auto-form label {
            font-weight: bold;
            color: #e07fe0;  /* Colore per le etichette */
            display: block;
            margin: 10px 0 5px;
        }

        .auto-form input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 10px;
            font-size: 1rem;
        }

        /* Pulsante di invio */
        .auto-form button {
            width: 100%;
            padding: 10px;
            background-color: #e07fe0;  /* Colore per il pulsante Invia */
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
        }

        .auto-form button:hover {
            background-color: #c97bcd;  /* Colore al passaggio del mouse */
        }
        
    /* Contenitore della lista */
    .maintenance-list-container {
        margin-top: 30px;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .maintenance-list-container h3 {
        color: #e07fe0;
        margin-bottom: 15px;
    }

    /* Lista interventi */
    .maintenance-list {
        list-style-type: none;
        padding: 0;
        margin: 0;
    }

    .maintenance-list li {
        background-color: #fff;
        margin: 10px 0;
        padding: 15px;
        border: 1px solid #e07fe0;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.3s;
    }

    .maintenance-list li:hover {
        box-shadow: 0 4px 8px rgba(224, 127, 224, 0.5);
    }

    .maintenance-list li .intervention-title {
        font-weight: bold;
        font-size: 1.2rem;
        color: #e07fe0;
        margin-bottom: 5px;
    }

    .maintenance-list li .intervention-description {
        color: #555;
        font-size: 1rem;
    }
        
    </style>
</head>

<body>
 <div class="container">
    <h2>Benvenuto su Manutenzione Facile</h2>
    <p>Raccogli i dati della tua auto per ricevere suggerimenti di manutenzione personalizzati.</p>

    <!-- Elenco interventi -->
    <div class="maintenance-list-container">
        <h3>Tipi di intervento consigliati:</h3>
        <ul id="maintenanceList" class="maintenance-list">
            <!-- Gli interventi verranno caricati qui -->
        </ul>
    </div>

    <!-- Form per raccogliere i dati dell'auto -->
    <div class="auto-form">
        <label for="model">Modello dell'auto</label>
        <input type="text" id="model" placeholder="Inserisci il modello dell'auto">

        <label for="mileage">Quanti chilometri hai fatto dall'ultima manutenzione?</label>
        <input type="number" id="mileage" placeholder="Inserisci il chilometraggio">

        <label for="maintenanceDate">Data dell'ultima manutenzione</label>
        <input type="date" id="maintenanceDate">

        <label for="batteryDuration">Quanto tempo fa hai cambiato la batteria? (in anni)</label>
        <input type="number" id="batteryDuration" placeholder="Inserisci gli anni">

        <button id="saveCarBtn">Salva Auto</button>
    </div>
</div>
 

<script>
    // Funzione per salvare i dati dell'auto e associare la manutenzione
    document.getElementById('saveCarBtn').addEventListener('click', function () {
        const model = document.getElementById('model').value;
        const mileage = document.getElementById('mileage').value;
        const maintenanceDate = document.getElementById('maintenanceDate').value;
        const batteryDuration = document.getElementById('batteryDuration').value;

        // Verifica che i campi obbligatori siano compilati
        if (!model || !mileage || !maintenanceDate || !batteryDuration) {
            alert("Per favore, compila tutti i campi.");
            return;
        }

        // Recupera l'ID utente da localStorage
        const userId = localStorage.getItem("userId");

        // Controlla che l'ID utente sia presente
        if (!userId) {
            alert("Devi essere loggato per salvare l'auto.");
            return;
        }

        // Esegui la richiesta per salvare l'auto
        fetch('http://localhost:8080/api/v1/automob', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                km_totali: mileage, // Chilometraggio
                modello: model, // Campo per il modello dell'auto
                duratabatt: batteryDuration, // Durata della batteria
                data: maintenanceDate, // Data dell'ultima manutenzione
                utente: {
                    id: userId // ID utente
                }
            })
        })
            .then(response => response.json())
            .then(data => {
                // Una volta che l'auto è salvata, ottieni l'id auto appena salvato
                const carId = data.id_auto;

                // Ora invia la richiesta per associare la manutenzione
                fetch('http://localhost:8080/api/v1/idauto/cambiobatt', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        id_auto: carId, // ID auto
                        modello: model, // Modello dell'auto
                        km_totali: mileage, // Chilometraggio
                        duratabatt: batteryDuration, // Durata batteria
                        data: maintenanceDate, // Data di manutenzione (aggiunta)
                        utente: {
                            id: userId // ID utente
                        }
                    })
                })
                    .then(response => response.json())
                    .then(manutenzioneData => {
                        alert("Manutenzione associata con successo!");
                        // Puoi anche aggiungere un redirect o aggiornare la pagina
                    })
                    .catch(error => {
                        console.error('Errore nell\'associazione della manutenzione:', error);
                        alert('Si è verificato un errore durante l\'associazione della manutenzione.');
                    });

            })
            .catch(error => {
                console.error('Errore nel salvataggio dell\'auto:', error);
                alert('Si è verificato un errore durante il salvataggio dell\'auto.');
            });
    });

    // Funzione di logout
    document.getElementById('logoutBtn').addEventListener('click', () => {
        // Rimuovi l'ID utente dall'archiviazione
        localStorage.removeItem("userId");

        // Reindirizza alla pagina di login
        window.location.href = 'Login.html';
    });

    // Carica l'email dell'utente nella topbar
    window.onload = function () {
        const userEmail = localStorage.getItem("userEmail");
        if (userEmail) {
            document.getElementById('userEmail').innerText = `Email: ${userEmail}`;
        } else {
            document.getElementById('userEmail').innerText = "Email non trovata.";
        }
    };
</script>

   
</body>

</html>
