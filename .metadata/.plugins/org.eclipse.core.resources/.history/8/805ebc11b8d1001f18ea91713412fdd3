	        auto.getManutenzioni().add(tipoManutenzione);
	    }

	    Arepository.save(auto);
	}



	@Override
	public void deleteById(Integer id_auto) {
		Arepository.deleteById(id_auto);
	}



	

	
	





	
		
		
		
