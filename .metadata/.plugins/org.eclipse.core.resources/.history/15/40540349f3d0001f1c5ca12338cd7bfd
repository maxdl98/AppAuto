package com.jaita120.controller;

import java.time.LocalDateTime;

import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.jaita120.entities.Auto;
import com.jaita120.entities.Tipo_Manutenzione;
import com.jaita120.entities.Utente;
import com.jaita120.service.AutoService;


@CrossOrigin(origins = "http://localhost:3000") // Consenti le richieste da questa origine
@RestController
@RequestMapping("api/v1")
public class AutoController {

	@Autowired
	private AutoService service;	
	
	
	//http://localhost:8080/api/v1/end-point
	
	
	
	
	@PostMapping("/automob")
	public ResponseEntity<?> save(@RequestBody Auto auto) {
	    try {
	        // Imposta la data di creazione se non fornita
	        if (auto.getDataCreazione() == null) {
	            auto.setDataCreazione(LocalDateTime.now());
	        }

	        // Salva l'auto usando il service
	        Auto savedAuto = service.save(auto);

	        // Restituisci una risposta con lo stato 201 (Created) e il corpo dell'entità salvata
	        return new ResponseEntity<>(savedAuto, HttpStatus.CREATED);
	    } catch (Exception e) {
	        // Logga l'errore per debugging
	        e.printStackTrace();

	        // Restituisci una risposta con lo stato 400 (Bad Request) e un messaggio d'errore
	        return ResponseEntity.status(HttpStatus.BAD_REQUEST)
	                            .body("Errore durante il salvataggio dell'auto: " + e.getMessage());
	    }

	}
	
	
	
	@GetMapping("/auto")
	public ResponseEntity<?> findById(@RequestParam Integer id_auto){
		
		try {
			return new ResponseEntity<>(service.findById(id_auto), HttpStatus.OK);

		}catch(Exception e) {
			e.printStackTrace();
			
			return (ResponseEntity<?>) ResponseEntity.status(HttpStatus.BAD_REQUEST);
		}
		
		
		
		
	}
	
	
	@PutMapping("/id_auto/cambiobatt")
	public ResponseEntity<?> manutenzioni(@RequestBody Auto auto) {
		
		try {
			
			
			
			service.manutenzioni(auto);
			return ResponseEntity.ok("Manutenzione Associata");
		}catch(Exception e) {
			return ResponseEntity.status(400).body("Errore: "  + e.getMessage());
		}
		
	}

	
	


}

