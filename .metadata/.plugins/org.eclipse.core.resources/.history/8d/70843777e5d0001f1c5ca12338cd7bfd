<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

<style>

    body {
        background-color: rgba(0, 0, 0, 0.793);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }

    .form-wrapper {
        text-align: center;
        color: white;
    }

    .registrazione {
        font-size: 50px;
        margin-bottom: 20px; /* Spazio tra il titolo e il form */
    }

    .container {
        display: flex;
        flex-direction: column;
        width: 500px;
        gap: 8px;
        font-size: 20px;
        margin: 0 auto; /* Centrare il contenitore */
    }

    


    label {
        color: white;
        text-align: left;
        font-family: Georgia, 'Times New Roman', Times, serif;

    }

    

    input:required:invalid{
        border: solid red 4px;
    }

    input:valid{
        border: solid rgb(17, 209, 17) 4px;
    }



    

    

    input {
        border-radius: 10px;
        height: 34px;
        padding: 5px;
    }

    .invio{
        width: 110px;
        height: 40px;
        border-radius: 20px;
        margin-left: 190px;
        margin-top: 20px;
        font-size: 20px;
        font-family: Georgia, 'Times New Roman', Times, serif;
        cursor: pointer;
    }

    .errore{
        font-size: 14px;
        color:red;
    }

    .miao{
        border: solid 3px white;
        width: 200px;
        background-color: rgb(250, 229, 6);
        color: black;

    }

</style>     

</head>
<body>
    <div class="form-wrapper">
        <label class="registrazione">Registrazione</label>  
        <div class="container"> 
            <label class="label" for="nome">Nome</label>
            <input placeholder="Inserisci nome" required  type="text" id="nome" name="nome" />
            
            <label class="label" for="cognome">Cognome</label>
            <input placeholder="Inserisci cognome" required  type="text" id="cognome" name="cognome" />
            
            <label class="label" for="email">Email</label>
            <input placeholder="Inserisci email" required type="email" id="email" name="email" />
            
            <label class="label" for="nascita">Data di nascita</label>
            <input placeholder="Inserisci usurname" required type="date" id="nascita" name="nascita" />
            
            <label class="label" for="usurname">Username</label>
            <input required  type="text" id="usurname" name="usurname" />
            
            <label class="label" for="password">Password</label>
            <input placeholder="Inserisci una password" required type="password" id="password" name="password" />
            <button id="button" type="submit" class="invio" > Invia </button>
            <p id = "errore" class="" >  </p>
        </div>
    </div>
 
<script>
    document.getElementById("button").addEventListener("click", function(event) {
        event.preventDefault(); // Impedisce il comportamento di submit predefinito

        // Recupera i dati dal modulo
        const nome = document.getElementById("nome").value;
        const cognome = document.getElementById("cognome").value;
        const email = document.getElementById("email").value;
        const nascita = document.getElementById("nascita").value;
        const usurname = document.getElementById("usurname").value;
        const password = document.getElementById("password").value;

        // Crea l'oggetto utente da inviare al server
        const utente = {
            nome: nome,
            cognome: cognome,
            email: email,
            dataNascita: nascita,
            usurname: usurname,
            password: password
        };

        // Invia i dati al server utilizzando la Fetch API
        fetch("http://localhost:8080/api/v1/utenti", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(utente)
        })
        .then(response => {
            if (response.ok) {
                return response.json();
            } else {
                throw new Error("Errore durante la registrazione.");
            }
        })
        .then(data => {
            // Gestisci la risposta dal server
            if (data && data.id) {
                // Successo, reindirizza alla pagina di login
                alert("Registrazione avvenuta con successo!");
                window.location.href = "Login.html"; // Reindirizza alla pagina di login
            } else {
                // Se non c'è una risposta valida, mostra un messaggio di errore
                document.getElementById("errore").textContent = "Errore nella registrazione!";
            }
        })
        .catch(error => {
            // Gestisci eventuali errori
            console.error("Errore:", error);
            document.getElementById("errore").textContent = "Errore nella connessione con il server.";
        });
    });
</script>
    
</body>

</html>
