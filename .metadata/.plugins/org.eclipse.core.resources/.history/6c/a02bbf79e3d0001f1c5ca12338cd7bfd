<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <style>
        /* Stile generale */
        body {
            background-color: rgba(0, 0, 0, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            color: white;
        }

        /* Contenitore principale */
        .container {
            border-radius: 20px;
            padding: 20px;
            width: 300px;
            text-align: center;
        }

        /* Titolo */
        .container h2 {
            margin-bottom: 20px;
            color: white;
        }

        /* Input */
        .container .input-field {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 10px;
            font-size: 1rem;
        }

        /* Pulsante di invio */
        .container .btn {
            width: 105%;
            padding: 10px;
            background-color: #bf74f5;
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
        }

        .container .btn:hover {
            background-color: #e07fe0;
        }

        /* Link */
        .container a {
            display: block;
            margin-top: 15px;
            color: #bf74f5;
            text-decoration: none;
            font-size: 0.9rem;
            position: relative;
            top: 17px;
            left: 7px;
        }

        .container a:hover {
            text-decoration: underline;
        }

        .container .divider {
            margin: 20px 0;
            color: white;
            font-size: 0.9rem;
            position: relative;
            top: 15px;
            left: 10px;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Login</h2>
        <p>Inserisci le tue credenziali per accedere.</p>
        <input id="email" class="input-field inpEmail" type="email" placeholder="Inserisci la tua email" autocomplete = "off">
        <input id="password" class="input-field inpPass" type="password" placeholder="Inserisci la tua password" autocomplete ="off">
        <button class="btn" id="invia">Accedi</button>
        <label class="divider">______oppure ______</label>
        <a href="RecuperoPassword.html">Password dimenticata?</a>
        <a href="Registrazione.html">Non hai un account? Registrati</a>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const emailInput = document.getElementById("email");
        const passwordInput = document.getElementById("password");

        if (emailInput) emailInput.value = "";
        if (passwordInput) passwordInput.value = "";
    });
    
    
        document.getElementById("invia").addEventListener("click", function () {
            const emailInput = document.querySelector(".inpEmail").value;
            const passwordInput = document.querySelector(".inpPass").value;

            // Controlla che l'email e la password siano compilati
            if (!emailInput || !passwordInput) {
                alert("Per favore, inserisci sia l'email che la password.");
                return;
            }

            // Esegui la richiesta di login
            fetch('http://localhost:8080/api/v1/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    email: emailInput,
                    password: passwordInput
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.message === "Login effettuato con successo") {
                    // Salva l'email nel localStorage
                    localStorage.setItem("usurname", emailInput); // Salva l'email inserita nel login

                    // Reindirizza alla homepage
                    window.location.href = 'index.html';
                } else {
                    // Se il login fallisce, mostra l'errore
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Errore nel login:', error);
                alert('Si è verificato un errore durante il login.');
            });
        });
    </script>
</body>

</html>
