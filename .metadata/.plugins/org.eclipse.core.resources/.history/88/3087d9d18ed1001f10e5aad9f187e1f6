	@CrossOrigin(origins = "http://localhost:3000") // Sostituisci con l'URL del tuo frontend
	@PutMapping("/pass")
	public ResponseEntity<?> updatePass(@RequestBody Utente user) throws Exception{
		
		try {
			Utente uti = service.updatePassword(user.getEmail(), user.getPassword());
			
			return new ResponseEntity<Utente>(uti, HttpStatus.OK);
		}catch(Exception e) {
			return new ResponseEntity<>(e.getMessage(), HttpStatus.BAD_REQUEST);
		}
		
		
		
		
	}
	
	
