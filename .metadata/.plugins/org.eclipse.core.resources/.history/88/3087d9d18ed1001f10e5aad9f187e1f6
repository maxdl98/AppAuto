	 @PostMapping("/login")
	 public ResponseEntity<?> login(HttpServletRequest request, HttpServletResponse response, @RequestBody LoginRequest loginRequest) {
	     try {
	         // Autentica l'utente utilizzando email e password
	         Utente u = service.authenticate(loginRequest.getEmail(), loginRequest.getPassword());

	         // Crea la sessione e salva l'email
	         HttpSession session = request.getSession();
	         session.setAttribute("email", loginRequest.getEmail());

	         // Restituiamo una risposta di successo (login riuscito) con l'ID dell'utente
	         return ResponseEntity.ok(Map.of(
	             "message", "Login effettuato con successo",
	             "user", Map.of(
	                 "id", u.getId(),  // Restituisci l'ID dell'utente
	                 "email", u.getEmail()  // Restituisci l'email dell'utente (opzionale)
	             )
	         ));

	     } catch (Exception e) {
	         // Risposta per credenziali errate o altro errore
	         return ResponseEntity.status(HttpServletResponse.SC_UNAUTHORIZED).body(Map.of(
	             "message", e.getMessage()
	         ));
	     }
	 }







	
	
	
	
	
	
